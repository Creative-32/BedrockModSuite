        SDK::Block* block = Get(arguments[0]);

        std::string id = "air";

        if (block->legacyBlock) {
            id = block->legacyBlock->namespacedId.getString();
        }

        std::string add = std::format("{} ({})", util::WStrToStr(thi->name), id);
