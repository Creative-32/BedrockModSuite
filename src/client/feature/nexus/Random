    friend _CONSTEXPR20 void swap(_Vb_reference _Left, _Vb_reference _Right) noexcept {
        bool _Val = _Left; // NOT _STD swap
        _Left = _Right;
        _Right = _Val;
    }

    friend _CONSTEXPR20 void swap(_Vb_reference _Left, bool& _Right) noexcept {
        bool _Val = _Left; // NOT _STD swap
        _Left = _Right;
        _Right = _Val;
    }

    friend _CONSTEXPR20 void swap(bool& _Left, _Vb_reference _Right) noexcept { swap(_Right, _Left); }

protected:
    _CONSTEXPR20 _Vbase _Mask() const noexcept { return static_cast<_Vbase>(1) << this->_Myoff; }
};

