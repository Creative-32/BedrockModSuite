    /// </summary>
    JsErrorNotImplemented,
    /// <summary>
    ///     A hosting API was called on the wrong thread.
    /// </summary>
    JsErrorWrongThread,
    /// <summary>
    ///     A runtime that is still in use cannot be disposed.
    /// </summary>
    JsErrorRuntimeInUse,
    /// <summary>
